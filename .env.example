# Vorlage für die Zugangsdaten der Produktivumgebung.
#
# Auf der VM eine Kopie als .env neben der docker-compose.yml anlegen:
#
#     cp .env.example .env && nano .env
#
# Die Datei .env ist gitignored. Docker Compose liest sie automatisch und setzt
# die Werte in docker-compose.yml ein. Fehlt ein Wert, bricht
# "docker compose up" mit einer Meldung ab.


# --- Datenbank ---------------------------------------------------------------
#
# Die MySQL läuft auf der VM selbst, nicht im Container. host.docker.internal
# zeigt auf den Host - dafür sorgt der Eintrag extra_hosts in der
# docker-compose.yml.
#
# ACHTUNG, zwei Dinge müssen auf dem Host passen, sonst gibt es "connection
# refused" (siehe README):
#   1. MySQL muss auf der Docker-Bridge lauschen, nicht nur auf 127.0.0.1.
#   2. Der Benutzer muss von der Docker-Subnetz-Adresse aus zugelassen sein,
#      nicht nur von 'localhost'.
#
ATW_DB_DSN=benutzer:passwort@tcp(host.docker.internal:3306)/ffw


# --- Signaturschlüssel der Anmeldung -----------------------------------------
#
# Bitte einen eigenen, langen Wert setzen. Wer diesen Schlüssel kennt, kann
# sich als beliebiger Benutzer ausgeben.
#
# Erzeugen mit:  openssl rand -base64 48
#
# Ein Wechsel macht alle ausgegebenen Tokens ungültig, alle müssen sich einmal
# neu anmelden.
#
ATW_JWT_SECRET=bitte-aendern
