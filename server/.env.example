# Konfiguration des Go-Backends. Alle Variablen sind optional; ohne sie gelten
# die Defaults aus dem Quellcode (identisch mit dem Verhalten vor dem Upgrade).
#
# Diese Datei ist nur die Vorlage. Fuer die lokale Entwicklung eine Kopie als
# server/.env anlegen - die wird beim Start eingelesen und ist gitignored.
# Echte Umgebungsvariablen haben Vorrang vor der Datei.

# MySQL-Verbindung. Default: ffwadmin:...@tcp(host.docker.internal:3306)/ffw
# Lokal ohne Docker typischerweise:
# ATW_DB_DSN=ffwadmin:gnidmewff@tcp(localhost:3306)/ffw

# Adresse, auf der der Server lauscht. Default: :8080 (alle Interfaces).
# Nur auf loopback binden:
# ATW_LISTEN_ADDR=127.0.0.1:8080

# Signaturschluessel fuer die JWTs. Default: my_secret_key
# In Produktion unbedingt ueberschreiben - ein Wechsel macht alle
# ausgegebenen Tokens ungueltig, die Nutzer muessen sich neu anmelden.
# ATW_JWT_SECRET=bitte-aendern

# Benachrichtigungen ueber ntfy. Standard ist eingeschaltet.
#
# Fuer die lokale Entwicklung auf false setzen - sonst gehen bei jedem Speichern
# echte Benachrichtigungen an die Themen, die die Nutzer abonniert haben.
# ATW_NTFY_ENABLED=false
#
# Eigener ntfy-Server. Standard: https://ntfy.sh
# ATW_NTFY_URL=https://ntfy.example.com

# Adresse der Anwendung. Ist sie gesetzt, oeffnet ein Tipp auf die
# Benachrichtigung direkt die App. Ohne Angabe entfaellt der Link - ein falscher
# waere schlimmer als keiner.
# ATW_APP_URL=https://ffwemding.dynv6.net:11200/
